{
  "schema_version": "otg.v4-statistical-design.v1",
  "protocol_version": "v4",
  "design_status": "preregistered_before_v4_test_visibility",
  "scientific_question": "Holding the estimator, predictor, horizon, governor, direct executable follower, plant, limits, current-state policy, initial-state policy, fallback policy, input position stream, sample population, and runtime policy fixed, does including PVA rather than P target components change position reference-following performance?",
  "statistical_unit": "whole_trajectory",
  "population": {
    "dataset_id": "synthetic-feasible-v4",
    "split": "test",
    "trajectory_count": 120,
    "families": [
      "stationary_endpoint",
      "oscillatory",
      "piecewise_constant_jerk",
      "stop_and_go",
      "rapid_reversal",
      "boundary_grazing"
    ],
    "trajectories_per_family": 20,
    "demand_strata": [
      "low",
      "medium",
      "high",
      "near_limit"
    ],
    "trajectories_per_family_demand_cell": 5,
    "inclusion_rule": "all manifest-listed test trajectories",
    "deletion_permitted": false,
    "complete_case_deletion_permitted": false,
    "sample_level_independence_assumed": false
  },
  "alignment_and_metrics": {
    "target_command_alignment": "target[k]_to_command[k+1]",
    "metric_time_axis": "command_time",
    "reference_value": "analytic truth position evaluated at command_time",
    "position_rmse_per_trajectory": "sqrt(mean over all command-time samples and joints of (command_p-reference_p_at_command_time)^2)",
    "position_max_abs_error_per_trajectory": "max over all command-time samples and joints of abs(command_p-reference_p_at_command_time)",
    "lag_per_trajectory": {
      "definition": "signed best-lag diagnostic on the unshifted command-time grid; positive means command output is late",
      "selection": "lag minimizing RMSE with ties resolved by smaller absolute lag then smaller signed lag",
      "max_lag_s": 1.0,
      "minimum_overlap_fraction": 0.5,
      "primary_metrics_shifted_by_lag": false
    }
  },
  "primary": {
    "comparison_id": "PVA_vs_P_position_RMSE",
    "baseline_method": "one_step_governed_p_direct",
    "candidate_method": "one_step_governed_pva_direct",
    "metric": "position_rmse",
    "estimand": {
      "baseline_mean": "mean_i(RMSE_P(i))",
      "candidate_mean": "mean_i(RMSE_PVA(i))",
      "absolute_improvement": "mean_i(RMSE_P(i))-mean_i(RMSE_PVA(i))",
      "relative_improvement": "(mean_i(RMSE_P(i))-mean_i(RMSE_PVA(i)))/mean_i(RMSE_P(i))",
      "positive_direction": "candidate_improves_tracking"
    },
    "null_hypothesis": "relative_improvement <= 0",
    "alternative_hypothesis": "relative_improvement > 0",
    "denominator_required": 120,
    "paired_ids_required": "exact equality with all 120 manifest test trajectory IDs",
    "bootstrap": {
      "paired": true,
      "unit": "whole_trajectory",
      "resamples": 10000,
      "seed": 2026072301,
      "rng": "numpy.random.Generator(numpy.random.PCG64(seed))",
      "input_order": "trajectory_id lexicographic ascending",
      "draw_algorithm": "for each resample draw n indices independently and uniformly with replacement from integers [0,n)",
      "confidence_level": 0.95,
      "interval": "two_sided_percentile",
      "quantiles": [
        0.025,
        0.975
      ],
      "quantile_method": "linear",
      "resample_estimand": "ratio_of_resampled_means for relative improvement; difference_of_resampled_means for absolute improvement",
      "draw_retention": "retain all 10000 draws or retain this exact algorithm, fixed seed, locked NumPy version, and ordered paired input sufficient to reproduce them"
    },
    "classification": {
      "derived_flags": {
        "confirmed_positive": "relative_CI_lower > 0",
        "practically_material": "relative_CI_lower > 0 and relative_point_estimate >= 0.05",
        "strongly_material": "relative_CI_lower >= 0.05",
        "inconclusive": "relative_CI_lower <= 0 and relative_CI_upper >= 0",
        "confirmed_harmful": "relative_CI_upper < 0"
      },
      "single_label_precedence": [
        "confirmed_harmful",
        "strongly_material",
        "practically_material",
        "confirmed_positive",
        "inconclusive"
      ],
      "boundary_rules": {
        "lower_equal_zero": "inconclusive",
        "upper_equal_zero": "inconclusive",
        "lower_equal_five_percent": "strongly_material"
      },
      "protocol_valid_but_nonpositive_status": "complete_negative",
      "negative_result_preserved": true
    }
  },
  "guardrails": {
    "comparison": "one_step_governed_pva_direct_vs_one_step_governed_p_direct",
    "do_not_change_primary_rmse_estimate": true,
    "bootstrap": {
      "paired": true,
      "unit": "whole_trajectory",
      "resamples": 10000,
      "seed": 2026072303,
      "rng": "numpy.random.Generator(numpy.random.PCG64(seed))",
      "confidence_level": 0.95,
      "interval": "two_sided_percentile",
      "upper_bound": "97.5th percentile",
      "quantile_method": "linear"
    },
    "max_error_noninferiority": {
      "estimand": "(mean_i(max_error_PVA(i))-mean_i(max_error_P(i)))/mean_i(max_error_P(i))",
      "worsening_positive": true,
      "margin": 0.05,
      "pass_rule": "upper_95_CI <= 0.05"
    },
    "lag_noninferiority": {
      "estimand": "mean_i(lag_PVA(i)-lag_P(i))",
      "unit": "s",
      "worsening_positive": true,
      "margin_s": 0.01,
      "pass_rule": "upper_95_CI <= 0.01"
    },
    "claim_rule": "The phrase 'improves tracking without material degradation in lag or peak error' is permitted only if primary confirmed_positive is true and both guardrails pass.",
    "failed_guardrail_policy": "report the RMSE result and the tradeoff; prohibit 'without degradation' wording"
  },
  "secondary": {
    "comparison_family": [
      {
        "id": "S1",
        "candidate_method": "one_step_governed_pv_direct",
        "baseline_method": "one_step_governed_p_direct",
        "metric": "position_rmse",
        "positive_direction": "baseline_minus_candidate"
      },
      {
        "id": "S2",
        "candidate_method": "one_step_governed_pva_direct",
        "baseline_method": "one_step_governed_pv_direct",
        "metric": "position_rmse",
        "positive_direction": "baseline_minus_candidate"
      },
      {
        "id": "S3",
        "candidate_method": "one_step_governed_pva_direct",
        "baseline_method": "one_step_governed_p_direct",
        "metric": "position_max_abs_error",
        "positive_direction": "baseline_minus_candidate"
      },
      {
        "id": "S4",
        "candidate_method": "one_step_governed_pva_direct",
        "baseline_method": "one_step_governed_p_direct",
        "metric": "lag_s",
        "positive_direction": "baseline_minus_candidate"
      },
      {
        "id": "S5",
        "candidate_method": "raw_predicted_pva_ordinary_ruckig",
        "baseline_method": "predicted_p_ordinary_ruckig",
        "metric": "position_rmse",
        "positive_direction": "baseline_minus_candidate",
        "contextual_only": true
      }
    ],
    "required_outputs_each": [
      "absolute_difference",
      "relative_difference",
      "cohen_dz",
      "unadjusted_p",
      "holm_adjusted_p",
      "bootstrap_CI",
      "harmful_trajectory_rate"
    ],
    "bootstrap": {
      "paired": true,
      "unit": "whole_trajectory",
      "resamples": 10000,
      "base_seed": 2026072302,
      "comparison_seed_rule": "base_seed plus zero-based comparison order S1 through S5",
      "rng": "numpy.random.Generator(numpy.random.PCG64(comparison_seed))",
      "confidence_level": 0.95,
      "interval": "two_sided_percentile",
      "quantile_method": "linear"
    },
    "p_value": {
      "test": "two-sided paired t-test on per-trajectory signed improvement values",
      "zero_variance_rule": "if every difference is zero, p=1; if variance is zero and the common difference is nonzero, p=0",
      "alpha": 0.05
    },
    "cohen_dz": {
      "definition": "mean(paired signed improvement)/sample_standard_deviation(paired signed improvement, ddof=1)",
      "zero_variance_rule": "emit null and a machine-readable zero_variance flag; do not emit infinity"
    },
    "holm": {
      "applies_to": [
        "S1",
        "S2",
        "S3",
        "S4",
        "S5"
      ],
      "family_size": 5,
      "procedure": "sort unadjusted p ascending with comparison ID as tie-break; multiply by remaining family size; enforce cumulative maximum; cap at 1; restore original comparison order",
      "alpha": 0.05
    },
    "incomplete_pair_policy": {
      "primary_methods": "formal inference invalid; retain all units and classify unavailable_incomplete_denominator",
      "ordinary_ruckig": "mark S5 unavailable and retain attempted/completed/failed denominators; do not perform complete-case paired inference"
    }
  },
  "harm_and_worst_case": {
    "harmful_trajectory": "candidate position_rmse > baseline position_rmse",
    "tie_is_harmful": false,
    "denominator": "all required paired trajectory IDs",
    "rate_interval": "Wilson 95% binomial interval",
    "worst_five_rule": "sort candidate-minus-baseline position_rmse descending, then trajectory_id ascending; retain first five",
    "negative_or_harmful_rows_may_be_removed": false
  },
  "subgroups": {
    "status": "secondary",
    "post_test_subgroups_permitted": false,
    "reference_family": {
      "levels": [
        "stationary_endpoint",
        "oscillatory",
        "piecewise_constant_jerk",
        "stop_and_go",
        "rapid_reversal",
        "boundary_grazing"
      ],
      "expected_count_each": 20
    },
    "demand_stratum": {
      "levels": [
        "low",
        "medium",
        "high",
        "near_limit"
      ],
      "expected_count_each": 30
    },
    "acceleration_active": {
      "definition": "demand_stratum in {high,near_limit} AND family in {piecewise_constant_jerk,stop_and_go,rapid_reversal,boundary_grazing}",
      "metadata_only": true,
      "expected_count": 40
    },
    "reported_each": [
      "trajectory_count",
      "relative_improvement",
      "absolute_improvement",
      "bootstrap_CI",
      "harmful_rate"
    ],
    "bootstrap": {
      "resamples": 10000,
      "base_seed": 2026072304,
      "seed_rule": "base_seed plus lexicographic subgroup ordinal",
      "unit": "whole_trajectory",
      "interval": "two_sided_percentile",
      "confidence_level": 0.95
    },
    "heterogeneity": {
      "family_effect_range": "maximum family relative improvement minus minimum family relative improvement",
      "demand_effect_range": "maximum demand-stratum relative improvement minus minimum demand-stratum relative improvement",
      "worst_family_effect": "minimum family relative improvement with family-name lexicographic tie-break",
      "inference_status": "descriptive_secondary"
    },
    "overall_result_dominates_interpretation": true
  },
  "plot_selection": {
    "selection_must_be_computed_after_all_locked_statistics_without_manual_choice": true,
    "primary_figures": [
      "P_PV_PVA_trajectory_level_RMSE_distribution",
      "paired_PVA_minus_P_RMSE_effect",
      "family_stratified_effect",
      "demand_stratum_effect",
      "harmful_rate_and_worst_case_summary",
      "target_velocity_acceleration_estimates_and_command_profiles",
      "continuous_constraint_margins",
      "runtime_distribution"
    ],
    "representative_trajectory_rules": [
      {
        "role": "overall_median_P_baseline_RMSE",
        "rule": "trajectory minimizing absolute distance to the median P baseline RMSE",
        "tie_break": "trajectory_id ascending"
      },
      {
        "role": "overall_median_paired_PVA_minus_P_improvement",
        "rule": "trajectory minimizing absolute distance to the median of RMSE_P minus RMSE_PVA",
        "tie_break": "trajectory_id ascending"
      },
      {
        "role": "worst_PVA_trajectory",
        "rule": "maximum PVA position RMSE",
        "tie_break": "trajectory_id ascending"
      },
      {
        "role": "maximum_PVA_harm",
        "rule": "maximum RMSE_PVA minus RMSE_P",
        "tie_break": "trajectory_id ascending"
      },
      {
        "role": "fixed_family_index_zero",
        "rule": "manifest index 0 from each of the six test families",
        "tie_break": "not_applicable"
      }
    ],
    "duplicate_role_policy": "retain and label every preregistered role even when one trajectory satisfies multiple roles",
    "style": {
      "grayscale_readable": true,
      "color_blind_friendly": true,
      "show_full_denominator": true,
      "time_axis": "command_time",
      "primary_caption_label": "synthetic locked test",
      "oracle_caption_label": "offline noncausal diagnostic",
      "ordinary_ruckig_caption_label": "contextual secondary"
    }
  },
  "oracle": {
    "information_condition": "offline_analytic_truth",
    "causal": false,
    "deployable": false,
    "diagnostic_only": true,
    "excluded_from_primary": true,
    "excluded_from_holm_family": true,
    "excluded_from_method_selection": true,
    "permitted_interpretations": [
      "perfect-information velocity or acceleration diagnostic",
      "estimator-information gap",
      "acceleration-active regime diagnostic"
    ],
    "online_deployment_claim_permitted": false
  },
  "runtime": {
    "independent_study": true,
    "repetitions": 5,
    "warmup_cycles_discarded_per_trajectory_per_repetition": 100,
    "included_components": [
      "estimator",
      "predictor",
      "governor",
      "follower",
      "plant",
      "total"
    ],
    "one_record_per_synchronized_cycle": true,
    "excluded": [
      "plotting",
      "disk_IO",
      "artifact_hashing"
    ],
    "thread_count": 1,
    "cpu_affinity": "fix_when_supported_else_record_unavailable",
    "environment_fields": [
      "CPU",
      "OS",
      "Python",
      "Ruckig_Community",
      "BLAS"
    ],
    "candidate_gates": {
      "total_p99_us_strict_max": 1000,
      "total_max_us_strict_max": 5000,
      "deadline_miss_rate_required": 0.0
    },
    "outlier_deletion_permitted": false,
    "failed_gate_policy": "retain actual result and classify source as scheduling or algorithm only when supported; do not rerun locked test"
  },
  "validity_preconditions": {
    "same_information_audit_required": true,
    "method_purity_rate_required": 1.0,
    "primary_attempted_and_completed_per_method": 120,
    "primary_failed_per_method": 0,
    "paired_denominator": 120,
    "projection_rate_required": 0.0,
    "fallback_rate_required": 0.0,
    "emergency_rate_required": 0.0,
    "continuous_constraint_violations_required": 0,
    "unexplained_nan_required": 0,
    "hidden_algorithm_replacement_required": 0
  },
  "prohibited": {
    "trajectory_deletion_based_on_results": true,
    "sample_level_inference": true,
    "post_test_metric_substitution": true,
    "post_test_threshold_change": true,
    "post_test_subgroup_creation": true,
    "favorable_family_only_reporting": true,
    "oracle_as_online_evidence": true,
    "ordinary_ruckig_as_primary": true,
    "cross_architecture_primary_comparison": true
  }
}
